# Ambiente Python (recria-se com requirements.txt — ver README)
python/.venv/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Definições locais (caminhos pessoais)
.vscode/
ros2_aquisicao/.env

# Pesos base do YOLO: descarregam-se sozinhos para modelos/ na 1.ª execução
modelos/yolo11*.pt
yolo*.pt

# Caches que o Ultralytics recria
*.cache

# Resultados das análises (app, main.py e linha de comandos): uma pasta por análise
resultados/

# Caches gerados a partir das gravações
dados/frames_bag.avi
dados/nuvens/

# Pesos YOLO descarregados pelo contentor da perceção
ros2_aquisicao/pesos/*
!ros2_aquisicao/pesos/.gitkeep

# Build do ROS 2 (se compilares fora do Docker)
ros2_aquisicao/build/
ros2_aquisicao/install/
ros2_aquisicao/log/
