# Ambiente Python (recria-se com requirements.txt — ver README)
python/.venv/
.venv/
__pycache__/
*.pyc

# Definições locais (caminhos pessoais)
.vscode/
ros2_aquisicao/.env

# Pesos base do YOLO: descarregam-se sozinhos na 1.ª execução
/yolo*.pt

# Caches que o Ultralytics recria
