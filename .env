# Identificação do grupo (lida automaticamente pelo docker compose)
GRUPO=g06
# Valor provisório; o oficial é fixado no repositório comum
ROS_DOMAIN_ID=42

# Imagem da câmara que a perceção e a visualização subscrevem. Se um bag (ou o sistema
# comum) usar outro nome ou a imagem sem compressão, basta mudar aqui:
#   IMAGE_TOPIC=/outro/nome/image_raw   e   COMPRIMIDA=false   (sensor_msgs/Image)
IMAGE_TOPIC=/atlascar2/camera_tras/image_raw/compressed
COMPRIMIDA=true

# Bag a reproduzir com --profile reproduzir (pasta dentro de ./data) e tópicos a reproduzir
# (vazio = a imagem acima + /tf /tf_static)
BAG=
TOPICOS=

# Câmara simulada (--profile simulado): vídeo dentro de ./data (vazio = estrada sintética).
# Para um vídeo gravado lado a lado (RGB | profundidade): METADE_SIM=esquerda
VIDEO_SIM=
METADE_SIM=

# Perceção. Só CPU: yolo11n + 640. Com GPU (compose.gpu.yaml): modelos/yolo11m.pt + 1280
MODELO=modelos/yolo11n.pt
IMGSZ=640

# Nome do percurso nas gravações (--profile gravar)
PERCURSO=percurso1

# Pose da câmara no carro (base_link -> camera_tras_link), em m e rad. MEDIR NO CARRO.
#   CAM_Z = altura ao solo; CAM_YAW ~ 3.14159 (câmara a olhar para trás); CAM_PITCH > 0 = para baixo
CAM_X=-0.50
CAM_Y=0.00
CAM_Z=1.75
CAM_ROLL=0.0
CAM_PITCH=0.0
CAM_YAW=3.14159
