Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: base_link
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Agentes (3D)
      Enabled: true
      Topic:
        Value: /atlascar2/camera_tras/percecao/marcadores
    - Class: rviz_default_plugins/Image
      Name: Imagem anotada
      Enabled: true
      Topic:
        Value: /atlascar2/camera_tras/percecao/imagem_anotada
        Transport Hint: compressed
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point:
        X: -10
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 3.14
