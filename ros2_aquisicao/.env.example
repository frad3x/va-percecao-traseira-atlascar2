# Copia este ficheiro para '.env' e preenche com os teus valores.
#   cp .env.example .env

# Imagem base do Docker. Se os docentes derem uma, mete-a aqui.
BASE_IMAGE=ros:jazzy-ros-base

# ONDE guardar as gravações (bags). Aponta para o disco externo (SSD).
# Ex.: /media/teu_user/VA_SSD/data   (confirma o caminho com 'lsblk' / 'df -h')
DATA_DIR=/media/USER/VA_SSD/data

# ROS 2 (deixa 0, ou o valor fixado no repositório comum)
ROS_DOMAIN_ID=0

# Ecrã para o rviz (normalmente :0)
DISPLAY=:0

# --- Montagem da câmara relativamente ao carro (base_link -> camera_tras_link) ---
# Mede no carro. Unidades: metros e radianos.
#   CAM_Z   = altura da câmara ao solo (m)
#   CAM_X   = distância à frente(+)/atrás(-) do ponto de referência do carro (m)
#   CAM_Y   = desvio lateral esquerda(+)/direita(-) (m)
#   CAM_YAW = rotação horizontal; câmara a apontar para trás ~ 3.14159 (180 graus)
#   CAM_PITCH = inclinação para baixo (rad);  5 graus ~ 0.087
#   CAM_ROLL  = 0 se a câmara estiver nivelada
CAM_X=-0.50
CAM_Y=0.00
CAM_Z=1.10
CAM_YAW=3.14159
CAM_PITCH=0.0
CAM_ROLL=0.0
