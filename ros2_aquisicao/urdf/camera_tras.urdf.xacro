<?xml version="1.0"?>
<!--
  Fragmento URDF da câmara traseira (Orbbec Astra Pro) do ATLASCAR2 — grupo G6.

  Para INCLUIR no URDF comum do carro (que já define o base_link):
    <xacro:include filename="camera_tras.urdf.xacro"/>
    <xacro:camera_tras parent="base_link" x="-0.50" y="0" z="1.10" roll="0" pitch="0" yaw="3.14159"/>

  Frames:
    camera_tras_link          — corpo da câmara: x para onde a câmara olha (para TRÁS do
                                carro), y para a esquerda, z para cima. É o frame_id das
                                imagens e das deteções.
    camera_tras_optical_frame — convenção ótica do ROS (z para a frente, x para a direita,
                                y para baixo), para quem projetar pontos na imagem.
  Unidades: metros e radianos. Mede x, y, z e a inclinação no carro (ver .env).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="camera_tras" params="parent:=base_link x:=-0.50 y:=0.0 z:=1.10 roll:=0.0 pitch:=0.0 yaw:=3.14159">

    <link name="camera_tras_link">
      <!-- caixa com as dimensões aproximadas da Astra Pro (165 x 40 x 30 mm) -->
      <visual>
        <geometry><box size="0.03 0.165 0.04"/></geometry>
        <material name="preto_camara"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><box size="0.03 0.165 0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.0007"/>
      </inertial>
    </link>

    <joint name="${parent}_to_camera_tras" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_tras_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <link name="camera_tras_optical_frame"/>
    <joint name="camera_tras_optical_joint" type="fixed">
      <parent link="camera_tras_link"/>
      <child link="camera_tras_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

  </xacro:macro>
</robot>
