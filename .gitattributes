# Ficheiros grandes / binários vão pelo Git LFS
*.mcap filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.avi  filter=lfs diff=lfs merge=lfs -text
*.pt   filter=lfs diff=lfs merge=lfs -text
va_datasets/** filter=lfs diff=lfs merge=lfs -text

# Texto com fins de linha normalizados (scripts .sh têm de ficar LF para o Ubuntu)
*.py   text eol=lf
*.sh   text eol=lf
*.md   text
