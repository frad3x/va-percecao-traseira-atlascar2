# Scripts e ficheiros de configuração sempre com fim de linha Linux (LF),
# mesmo quando o repositório é clonado em Windows.
* text=auto eol=lf

# Ficheiros grandes / binários vão pelo Git LFS
*.mcap filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.avi  filter=lfs diff=lfs merge=lfs -text
*.pt   filter=lfs diff=lfs merge=lfs -text
*.gif  binary
*.pdf  binary
*.png  binary
*.jpg  binary
va_datasets/** filter=lfs diff=lfs merge=lfs -text
